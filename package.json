{
  "name": "@adrouter/opencode",
  "version": "0.1.0",
  "description": "AdRouter provider and tiered sponsorship panel for OpenCode",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.18.4 <2"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepack": "bun run clean && bun run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.4 <2",
    "@opentui/core": ">=0.4.5 <1",
    "@opentui/solid": ">=0.4.5 <1",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.4",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.14",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "ai-sdk",
    "adrouter",
    "provider"
  ]
}
